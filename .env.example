# Copy to .env and fill in. Never commit .env.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# Optional demo seed password (generated and printed if empty)
DEMO_PASSWORD=
# Optional LLM provider for the (not yet implemented) assistant
LLM_PROVIDER=
LLM_API_KEY=
